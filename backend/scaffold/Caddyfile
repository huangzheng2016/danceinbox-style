{
	email you@example.com
}

# import app <upstream>
(app) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'"
	}
	# Event streams (routes ending in /stream) must reach the browser as they are
	# written: no compression, no buffering.
	@stream path */stream
	handle @stream {
		reverse_proxy {args[0]} {
			flush_interval -1
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy {args[0]}
	}
}

your-domain.tld {
	import app app:8080
}

test.your-domain.tld {
	import app app-test:8080
}
