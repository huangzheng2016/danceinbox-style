{
  "name": "<module_name>-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
